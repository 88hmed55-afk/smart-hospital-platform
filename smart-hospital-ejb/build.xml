<?xml version="1.0" encoding="UTF-8"?>
<project name="smart-hospital-ejb" default="jar">

    <description>Smart Hospital — EJB module (Jakarta EE 10)</description>

    <property file="../build.properties"/>
    <property environment="env"/>
    <property name="src.dir" location="src/java"/>
    <property name="conf.dir" location="src/conf"/>
    <property name="build.dir" location="build"/>
    <property name="dist.dir" location="dist"/>
    <property name="classes.dir" location="${build.dir}/classes"/>
    <property name="jakarta.api.jar"
              value="${user.home}/.smart-hospital/lib/jakarta.jakartaee-api-10.0.0.jar"/>

    <target name="check-tools">
        <fail message="Jakarta EE 10 API jar not found: ${jakarta.api.jar}. Set jakarta.api.jar in build.properties or JAKARTA_API_JAR.">
            <condition>
                <not>
                    <available file="${jakarta.api.jar}"/>
                </not>
            </condition>
        </fail>
        <fail message="JDK 17+ is required.">
            <condition>
                <not>
                    <available classname="java.lang.Record"/>
                </not>
            </condition>
        </fail>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="init">
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="check-tools, init">
        <javac srcdir="${src.dir}"
               destdir="${classes.dir}"
               release="17"
               encoding="UTF-8"
               debug="true"
               includeantruntime="false">
            <compilerarg value="-Xlint:all"/>
            <classpath>
                <pathelement location="${jakarta.api.jar}"/>
            </classpath>
        </javac>
    </target>

    <target name="jar" depends="compile">
        <jar destfile="${dist.dir}/smart-hospital-ejb.jar" compress="true">
            <fileset dir="${classes.dir}" includes="**/*.class"/>
            <zipfileset dir="${conf.dir}" includes="META-INF/**"/>
        </jar>
        <echo message="Built ${dist.dir}/smart-hospital-ejb.jar"/>
    </target>
</project>
